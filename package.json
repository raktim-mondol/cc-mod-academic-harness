{
  "name": "cc-mod-academic-harness",
  "version": "0.7.1",
  "private": true,
  "description": "Academic research toolkit for Claude Code: literature search, citation checks, deep research and review, hypothesis tournaments, study design, and guarded LaTeX paper writing.",
  "license": "MIT",
  "author": {
    "name": "Raktim Mondol"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "node scripts/build-all.mjs",
    "build:manifest": "node scripts/build-manifest.mjs",
    "check": "node scripts/check.mjs",
    "check:manifest": "node scripts/build-manifest.mjs --check",
    "test": "node --test \"tests/scripts/*.test.mjs\" \"tests/server/*.test.mjs\"",
    "test:plugin": "claude plugin test .",
    "typecheck": "node scripts/typecheck.mjs",
    "surface": "node scripts/measure-surface.mjs",
    "doctor": "node server/bin/ah-doctor.mjs"
  }
}
