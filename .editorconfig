# Editor settings shared by the repository. Editors that read EditorConfig apply these; the rest of the world may ignore it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2
